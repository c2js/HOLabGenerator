{
  "name": "workshop-capture",
  "version": "0.1.0",
  "description": "Capture a workshop and build a portable HTML guide with an in-app Copilot conversation.",
  "main": "./out/main/index.js",
  "author": "Workshop Capture",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "start": "electron-vite preview",
    "fetch:whisper": "node scripts/fetch-whisper.mjs",
    "make:icon": "node scripts/make-icon.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run smoke",
    "package:win": "npm run make:icon && electron-vite build && electron-builder --win --publish never",
    "package:dir": "electron-vite build && electron-builder --dir --publish never"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^40.10.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^7.3.5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true,
    "esbuild": true
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.34",
    "chokidar": "^5.0.0",
    "sharp": "^0.35.3"
  }
}
